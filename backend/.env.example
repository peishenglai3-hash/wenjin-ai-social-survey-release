# Copy this file to .env for local development. Never commit .env.
# Provider keys belong on the backend only; leave unused providers blank.

DEBUG=false
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Local defaults
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Run `alembic upgrade head` before startup. Keep this false for shared/prod DBs.
AUTO_CREATE_SCHEMA=false
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500

# Text generation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Vision and speech (Qwen / DashScope)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-max
QWEN_ASR_MODEL=paraformer-v2
QWEN_FILETRANS_MODEL=sensevoice-v1

# Optional providers
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_EMOTION_MODEL=
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=

# Versioned Open API gateway. Keep provider keys above on the backend only.
OPEN_API_ENABLED=true
OPEN_API_FAKE_ENABLED=false
OPEN_API_MAX_MESSAGES=64
OPEN_API_MAX_TOKENS=8192
QWEN_MODEL=qwen-plus

# Optional literature search and legacy speech fallback
SEMANTIC_SCHOLAR_API_KEY=
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=

# Optional ORCID OAuth; leave blank unless you configure your own application.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=
ORCID_SANDBOX=true

# Optional public callback base URL. Do not use a private deployment URL here.
PUBLIC_BASE_URL=

# Optional deployment-owned knowledge package. Runtime ingestion requires an
# approved manifest; leave blank for a clean public checkout.
KNOWLEDGE_DIR=

# Keep usage records outside public upload storage.
TOKEN_LOG_PATH=./logs/token_usage.jsonl
